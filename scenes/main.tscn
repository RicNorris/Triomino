[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/board.gd" id="2_board"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.055, 0.075, 1)
mouse_filter = 2

[node name="Layout" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Board" type="Control" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 0
script = ExtResource("2_board")

[node name="Sidebar" type="PanelContainer" parent="Layout"]
custom_minimum_size = Vector2(340, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Layout/Sidebar"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="Layout/Sidebar/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Layout/Sidebar/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.08, 0.13, 0.18, 1)
theme_override_font_sizes/font_size = 30
text = "TRIOMINO"

[node name="Subtitle" type="Label" parent="Layout/Sidebar/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.36, 0.42, 1)
theme_override_font_sizes/font_size = 15
text = "A first playable desktop prototype"

[node name="Separator" type="HSeparator" parent="Layout/Sidebar/Margin/Content"]
layout_mode = 2

[node name="ScorePanel" type="PanelContainer" parent="Layout/Sidebar/Margin/Content"]
layout_mode = 2

[node name="ScoreMargin" type="MarginContainer" parent="Layout/Sidebar/Margin/Content/ScorePanel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 10

[node name="ScoreRow" type="HBoxContainer" parent="Layout/Sidebar/Margin/Content/ScorePanel/ScoreMargin"]
layout_mode = 2

[node name="ScoreTitle" type="Label" parent="Layout/Sidebar/Margin/Content/ScorePanel/ScoreMargin/ScoreRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.3, 0.36, 0.42, 1)
