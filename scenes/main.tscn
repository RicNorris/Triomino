[node name="Status" type="Label" parent="Layout/Sidebar/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.08, 0.13, 0.18, 1)
theme_override_font_sizes/font_size = 18
text = "Choose your first piece"

[node name="Instructions" type="Label" parent="Layout/Sidebar/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.36, 0.42, 1)
theme_override_font_sizes/font_size = 14
text = "Select a piece below, then click the board.\nThe first piece always lands in the center."
